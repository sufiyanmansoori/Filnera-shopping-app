{
  "name": "filnerashop-fullstack",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run flutter\"",
    "backend": "npm --prefix backend run dev",
    "flutter": "cd Filnera && flutter run -d chrome",
    "flutter:android": "cd Filnera && flutter run -d android",
    "install:all": "npm --prefix backend install && cd Filnera && flutter pub get",
    "stop": "taskkill /F /IM node.exe & taskkill /F /IM dart.exe"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}